---
import Terminal from "@/components/Terminal.astro"
---

<section id="top" class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-32 pb-20 lg:min-h-svh lg:grid-cols-[1.05fr_1fr] lg:pt-24">
  <div>
    <p class="mb-5 font-mono text-sm text-muted">
      <span class="text-amber">$</span> founder · engineer · girvak alumni
    </p>
    <h1 class="text-[clamp(3.2rem,9vw,6.5rem)] leading-[0.95] font-bold tracking-tight text-fog">
      Doruk<br />Gezici
    </h1>
    <p class="mt-6 max-w-lg text-lg text-muted sm:text-xl">
      Curious hacker. Founder of <a
        href="https://popjam.io"
        target="_blank"
        rel="noopener"
        class="text-fog underline decoration-amber underline-offset-4 transition-colors hover:text-amber">POPJAM.IO</a
      >, building agentic marketing from Stockholm and Istanbul.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-4 font-mono text-sm">
      <a
        href="https://popjam.io"
        target="_blank"
        rel="noopener"
        class="bg-amber px-6 py-3 font-medium text-ink transition-transform hover:-translate-y-0.5"
      >
        Check out POPJAM →
      </a>
      <a
        href="https://cal.com/dorukgezici"
        target="_blank"
        rel="noopener"
        class="border border-line px-6 py-3 text-fog transition-colors hover:border-amber hover:text-amber"
      >
        book 30 min
      </a>
    </div>
  </div>

  <div class="reveal">
    <Terminal />
  </div>
</section>
